 elseif x<.62 then local u=ease((x-.30)/.32);return blend(prep,tuck,u),0,3.3*u,"TAKEOFF"
 elseif x<1.62 then local u=x-.62;return blend(tuck,opened,ease((u-.58)/.42)),-360*ease(u),3.3+.35*math.sin(math.pi*u)^2,"360 FLIP"
